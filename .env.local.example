# URL of the NestGuard FastAPI backend (see backend/README.md)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only (no NEXT_PUBLIC_ prefix — never shipped to the browser).
# Must match backend/.env's API_KEY. Attached automatically by server
# components (all current pages are server components — no client-side
# writes yet, so nothing proxies this to the browser).
HONEYCHAIN_API_KEY=dev-local-key
