# URL of the NestGuard FastAPI backend (see backend/README.md)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only (no NEXT_PUBLIC_ prefix, so never shipped to the browser).
# Must match backend/.env's API_KEY. The proxy routes in app/api/ attach it to
# browser-initiated writes (registering a box, starting/stopping the simulation).
HONEYCHAIN_API_KEY=dev-local-key
